pipeline {
  agent {
    kubernetes {
      defaultContainer 'kaniko'
      yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command:
        - /busybox/cat
      tty: true
    - name: helm
      image: alpine/helm:3.14.4
      command:
        - cat
      tty: true
'''
    }
  }

  parameters {
    string(name: 'IMAGE_TAG_PARAM', defaultValue: '', description: 'Image tag override. If empty, BUILD_NUMBER is used.')
    string(name: 'BACKEND_IMAGE_REPOSITORY_PARAM', defaultValue: 'docker.io/privatergistry/kubecoin-backend', description: 'Backend Docker image repo')
    string(name: 'FRONTEND_IMAGE_REPOSITORY_PARAM', defaultValue: 'docker.io/privatergistry/kubecoin-frontend', description: 'Frontend Docker image repo')
    string(name: 'KAFKA_IMAGE_PARAM', defaultValue: 'obsidiandynamics/kafka:latest', description: 'Kafka image to deploy')
    booleanParam(name: 'KAFKA_ENABLED_PARAM', defaultValue: true, description: 'Deploy Kafka infra service')
  }

  environment {
    REGISTRY_CREDENTIALS_ID = 'dockerhub-creds'
  }

  stages {
    stage('Build and Push Backend (Kaniko)') {
      steps {
        container('kaniko') {
          dir('backend') {
            withCredentials([usernamePassword(credentialsId: env.REGISTRY_CREDENTIALS_ID, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
              sh '''
                IMAGE_TAG="${IMAGE_TAG_PARAM:-$BUILD_NUMBER}"
                [ -z "$IMAGE_TAG" ] && IMAGE_TAG=latest
                export IMAGE_REPOSITORY_PARAM="$BACKEND_IMAGE_REPOSITORY_PARAM"

                mkdir -p /kaniko/.docker
                AUTH=$(printf "%s:%s" "$REG_USER" "$REG_PASS" | base64 | tr -d '\n')
                cat > /kaniko/.docker/config.json <<EOF
                {"auths":{"https://index.docker.io/v1/":{"auth":"$AUTH"}}}
EOF

                /kaniko/executor \
                  --context "$PWD" \
                  --dockerfile "$PWD/Dockerfile" \
                  --destination "${IMAGE_REPOSITORY_PARAM}:${IMAGE_TAG}" \
                  --destination "${IMAGE_REPOSITORY_PARAM}:latest"
              '''
            }
          }
        }
      }
    }

    stage('Build and Push Frontend (Kaniko)') {
      steps {
        container('kaniko') {
          dir('frontend') {
            withCredentials([usernamePassword(credentialsId: env.REGISTRY_CREDENTIALS_ID, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
              sh '''
                IMAGE_TAG="${IMAGE_TAG_PARAM:-$BUILD_NUMBER}"
                [ -z "$IMAGE_TAG" ] && IMAGE_TAG=latest
                export IMAGE_REPOSITORY_PARAM="$FRONTEND_IMAGE_REPOSITORY_PARAM"

                mkdir -p /kaniko/.docker
                AUTH=$(printf "%s:%s" "$REG_USER" "$REG_PASS" | base64 | tr -d '\n')
                cat > /kaniko/.docker/config.json <<EOF
                {"auths":{"https://index.docker.io/v1/":{"auth":"$AUTH"}}}
EOF

                /kaniko/executor \
                  --context "$PWD" \
                  --dockerfile "$PWD/Dockerfile" \
                  --destination "${IMAGE_REPOSITORY_PARAM}:${IMAGE_TAG}" \
                  --destination "${IMAGE_REPOSITORY_PARAM}:latest"
              '''
            }
          }
        }
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        container('helm') {
          sh '''
            IMAGE_TAG="${IMAGE_TAG_PARAM:-$BUILD_NUMBER}"
            [ -z "$IMAGE_TAG" ] && IMAGE_TAG=latest
            KAFKA_ENABLED="${KAFKA_ENABLED_PARAM:-true}"
            [ "$KAFKA_ENABLED" != "true" ] && [ "$KAFKA_ENABLED" != "false" ] && KAFKA_ENABLED=true
            KAFKA_IMAGE="${KAFKA_IMAGE_PARAM:-obsidiandynamics/kafka:latest}"
            [ -z "$KAFKA_IMAGE" ] && KAFKA_IMAGE="obsidiandynamics/kafka:latest"

            helm upgrade --install kubecoin infra-assignment/helm/kubecoin \
              --namespace infra \
              --create-namespace \
              --reset-values \
              --set backend.image.repository="${BACKEND_IMAGE_REPOSITORY_PARAM}" \
              --set backend.image.tag="${IMAGE_TAG}" \
              --set frontend.image.repository="${FRONTEND_IMAGE_REPOSITORY_PARAM}" \
              --set frontend.image.tag="${IMAGE_TAG}" \
              --set-string kafka.image="${KAFKA_IMAGE}" \
              --set kafka.enabled="${KAFKA_ENABLED}" \
              --wait \
              --timeout 10m
          '''
        }
      }
    }
  }
}
